@page "{id:guid}"
@model Quizzle.Pages.Questions.DeleteModel
@{
    ViewData["Title"] = "Delete Question";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h2 class="text-center">Delete Question</h2>
        </div>
        <div class="card-body">
            <p class="text-center text-danger fs-4">Are you sure you want to delete this question?</p>
            <div class="alert alert-warning text-center fs-5" role="alert">
                <strong>Question Text:</strong> @Model.Question?.QuestionText
            </div>

            <form method="post" class="text-center">
                <input type="hidden" name="QuestionId" value="@Model.Question?.Id" />
                <button type="submit" class="btn btn-danger btn-lg me-3 fs-6">Yes, Delete</button>
                <a asp-page="./Index" class="btn btn-secondary btn-lg fs-6">No, Cancel</a>
            </form>
        </div>
    </div>
</div>
